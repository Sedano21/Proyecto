[Unit]
Description=Sistema de Automatizacion - Modulo de Operaciones
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=operaciones
Group=operaciones
WorkingDirectory=/opt/operaciones
EnvironmentFile=/etc/operaciones/operaciones.env
ExecStart=/opt/operaciones/.venv/bin/gunicorn -c /opt/operaciones/deploy/gunicorn.conf.py run:app
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
