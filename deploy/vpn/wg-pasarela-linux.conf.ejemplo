# Opción A (recomendada): pasarela Linux en la red de la empresa (una VM pequeña o una mini PC siempre encendida).
# Llega al Service Layer en 172.18.103.1 sin instalar nada en el servidor de SAP. /etc/wireguard/wg0.conf
[Interface]
Address = 10.77.0.2/30
PrivateKey = <CLAVE_PRIVADA_DE_ESTA_PASARELA>        # wg genkey | tee pasarela.key | wg pubkey > pasarela.pub
# Reenvía solo hacia el Service Layer (puerto 50000) y enmascara la IP: SAP ve la conexión como de la pasarela
PostUp = sysctl -w net.ipv4.ip_forward=1; iptables -A FORWARD -i wg0 -d 172.18.103.1 -p tcp --dport 50000 -j ACCEPT; iptables -A FORWARD -o wg0 -m state --state ESTABLISHED,RELATED -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -d 172.18.103.1 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -d 172.18.103.1 -p tcp --dport 50000 -j ACCEPT; iptables -D FORWARD -o wg0 -m state --state ESTABLISHED,RELATED -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -d 172.18.103.1 -j MASQUERADE

[Peer]
# Servidor del módulo (AWS)
PublicKey = <CLAVE_PUBLICA_DEL_SERVIDOR>               # la muestra instalar_wireguard_servidor.sh
Endpoint = <IP_PUBLICA_DEL_SERVIDOR_AWS>:51820
AllowedIPs = 10.77.0.1/32
PersistentKeepalive = 25                              # la conexión sale desde la empresa: no hay que abrir puertos en su router
