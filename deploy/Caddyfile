# HTTPS automático (Let's Encrypt). Reemplace DOMINIO por el nombre elegido (p. ej. operaciones-cp.duckdns.org).
DOMINIO {
	encode gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
