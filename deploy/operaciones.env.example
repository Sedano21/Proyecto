# Variables del servidor (copiar a /etc/operaciones/operaciones.env, permisos 600, dueño root).
# NUNCA subir este archivo con valores reales al repositorio.
SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
DATABASE_URL=postgresql+psycopg://operaciones:CLAVE_BD@127.0.0.1:5432/operaciones
UPLOAD_DIR=/var/lib/operaciones/archivos
SESSION_COOKIE_SECURE=1
DEMO_MODE=0
# En el servidor el esquema lo gestiona Alembic (deploy/actualizar.sh): la app no crea tablas al iniciar
SCHEMA_AUTO_CREATE=0

# SAP Business One - Service Layer (base de PRUEBAS mientras dure la marcha blanca)
SAP_SL_URL=https://172.18.103.1:50000/
SAP_SL_COMPANY=ZZZ_CORPRODUC_TEST260826
SAP_SL_USER=usuario_integracion
SAP_SL_PASSWORD=
# El Service Layer suele usar un certificado propio: indique su CA (recomendado) o, solo en pruebas, SAP_SL_VERIFY=0
SAP_SL_CA=/etc/operaciones/sap_ca.pem
SAP_SYNC_MIN=1
SAP_SYNC_USER=sistemas

# Ingreso con Microsoft 365 y correo de alertas (ver docs/08 §9)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=https://DOMINIO/auth/microsoft/callback

# GEOSATELITAL: solo si el proveedor entrega un servicio de posiciones (el panel no necesita variables)
GEOSAT_API_URL=
GEOSAT_TOKEN=
